ConceptualModel WikiGames {
    
    Class Usuario <User>
    {
        attributes
        {
            private oid isToken id : Autogenerated (1, 1);
            private unique name : String (1, 1);
            private password : Password (1, 1);
            private rolUsuario : Rol (1, 1);
        }
        
        operations
        {
            public new::New (p_name : String, p_password : Password, p_rolUsuario : Rol) : Object->Usuario;
            public destroy::Destroy (p_oid : OID -> Usuario) : Void;
            public modify::Modifier (p_oid : OID -> Usuario, p_name : String, p_password : Password, p_rolUsuario : Rol) : Void;
            public readOID::ReadOID (p_oid : OID -> Usuario) : Object->Usuario;
            public readAll::ReadAll () : List<Object->Usuario>;
            public addDenunciasRecibida::Relationer -> UsuarioDenuncia.denunciasRecibidas (p_oid : OID -> Usuario, p_denuncia_oids : List<OID -> Denuncia>) : Void;
            
            public findByNameLinQ::ReadFilter (p_name : String) : List<Object->Usuario>
            {
                filterLinQ = "usuarios => usuarios.Where(u => u.Name.Contains(p_name)).ToListAsync()"
            };

            public findByTipoUsuario::ReadFilter (p_rol : Rol) : List<Object->Usuario>
            {
                filterLinQ = "usuarios => usuarios.Where(u => u.Rol == p_rol).ToListAsync()"
            };
        }
    };


    Enumeration Rol
    {
        (Registrado, 1), (Moderador, 2), (Administrador, 3)
    };

    Enumeration EstadoContenido
    {
        (Pendiente, 1), (Aprobado, 2), (Rechazado, 3)
    };

    Class Videojuego extends Contenido
    {
        attributes
        {
            private titulo : String(1,1);
            private enlace : String (1,1);
            private imagen : String (1, 1);
            private estado : EstadoContenido (1, 1);
        }
        
        operations
        {
            public newCustomized::New customized (p_texto : String, p_fechaCreacion : Date,  p_titulo : String, p_enlace : String, p_imagen : String, p_usuarioCreador_oid : OID -> Usuario) : Object->Videojuego;
            public destroy::Destroy (p_oid : OID -> Videojuego) : Void;
            public modify::Modifier (p_oid : OID -> Videojuego, p_texto : String, p_fechaCreacion : Date, p_numeroMeGusta : Integer, p_titulo : String, p_enlace : String, p_imagen : String, p_estado : EstadoContenido, p_usuarioCreador_oid : OID -> Usuario) : Void;
            public readOID::ReadOID (p_oid : OID -> Videojuego) : Object->Videojuego;
            public readAll::ReadAll () : List<Object->Videojuego>;
            public aprobarVideojuego::Custom (p_oid : OID -> Videojuego) : Void;
            public rechazarVideojuego::Custom (p_oid : OID -> Videojuego) : Void;

            public findByNombre::ReadFilter (p_texto : String) : List<Object->Videojuego>
            {
                filterLinQ = "entity => entity.Texto == p_texto"
            };

            public findByCategoria::ReadFilter (p_texto : String) : List<Object->Videojuego>
            {
                filterLinQ = "entity => entity.Texto == p_texto"
            };

            public findRecientes::ReadFilter (p_texto : String) : List<Object->Videojuego>
            {
                filterLinQ = "entity => entity.Texto == p_texto"
            };

            public findAntiguos::ReadFilter (p_texto : String) : List<Object->Videojuego>
            {
                filterLinQ = "entity => entity.Texto == p_texto"
            };

            public findPopulares::ReadFilter (p_texto : String) : List<Object->Videojuego>
            {
                filterLinQ = "entity => entity.Texto == p_texto"
            };
        }
    };

    Class Categoria
    {
        attributes
        {
            private oid isToken id : Autogenerated (1, 1);
            private unique name : String (1, 1);
        }

        operations
        {
            public newCustomized::New customized (p_name : String, p_videojuego_oid : OID -> Videojuego) : Object->Categoria;
            public destroy::Destroy (p_oid : OID -> Categoria) : Void;
            public modify::Modifier (p_oid : OID -> Categoria, p_name : String, p_videojuego_oid : OID -> Videojuego) : Void;
            public readOID::ReadOID (p_oid : OID -> Categoria) : Object->Categoria;
            public readAll::ReadAll () : List<Object->Categoria>;
            public addHijo::Relationer -> CategoriaCategoria.hijos (p_oid : OID -> Categoria, p_categoria2_oids : List<OID -> Categoria>) : Void;
            public addPadre::Relationer -> CategoriaCategoria.padre (p_oid : OID -> Categoria, p_categoria2_oid : OID -> Categoria) : Void;
            
            public findByNameLinQ::ReadFilter (p_name : String) : List<Object->Categoria>
            {
                filterLinQ = "entity => entity.Name == p_name"
            };
        }
    };

    Class TemaConversacion extends Contenido
    {
        attributes
        {
            private titulo : String (1, 1);
        }
        
        operations
        {
            public new::New (p_texto : String, p_fechaCreacion : Date, p_numeroMeGusta : Integer, p_titulo : String, p_videojuego_oid : OID -> Videojuego, p_usuarioCreador_oid : OID -> Usuario) : Object->TemaConversacion;
            public destroy::Destroy (p_oid : OID -> TemaConversacion) : Void;
            public modify::Modifier (p_oid : OID -> TemaConversacion, p_texto : String, p_fechaCreacion : Date, p_numeroMeGusta : Integer, p_titulo : String, p_videojuego_oid : OID -> Videojuego, p_usuarioCreador_oid : OID -> Usuario) : Void;
            public readOID::ReadOID (p_oid : OID -> TemaConversacion) : Object->TemaConversacion;
            public readAll::ReadAll () : List<Object->TemaConversacion>;

            public findByTitulo::ReadFilter (p_texto : String) : List<Object->TemaConversacion>
            {
                filterLinQ = "entity => entity.Texto == p_texto"
            };

            public findByRecientes::ReadFilter (p_texto : String) : List<Object->TemaConversacion>
            {
                filterLinQ = "entity => entity.Texto == p_texto"
            };
        }
    };

    Class Comentario extends Contenido
    {
        attributes
        {
        }
        
        operations
        {
            public new::New (p_texto : String, p_fechaCreacion : Date, p_numeroMeGusta : Integer, p_tema_oid : OID -> TemaConversacion, p_usuarioCreador_oid : OID -> Usuario) : Object->Comentario;
            public destroy::Destroy (p_oid : OID -> Comentario) : Void;
            public modify::Modifier (p_oid : OID -> Comentario, p_texto : String, p_fechaCreacion : Date, p_numeroMeGusta : Integer, p_tema_oid : OID -> TemaConversacion, p_usuarioCreador_oid : OID -> Usuario) : Void;
            public readOID::ReadOID (p_oid : OID -> Comentario) : Object->Comentario;
            public readAll::ReadAll () : List<Object->Comentario>;  
         public addComentarioAsociado::Relationer -> ComentarioComentario.comentarioAsociado (p_oid : OID -> Comentario, p_comentario2_oid : OID -> Comentario) : Void;
        public addRespuesta::Relationer -> ComentarioComentario.respuestas (p_oid : OID -> Comentario, p_comentario2_oids : List<OID -> Comentario>) : Void;     
        }
    };

    Class Denuncia
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private fecha : Date (1, 1);
            private estado : EstadoContenido (1, 1);
        }
        
        operations
        {
            public newCustomized::New customized (p_fecha : Date, p_denunciante_oid : OID -> Usuario) : Object->Denuncia;
            public destroy::Destroy (p_oid : OID -> Denuncia) : Void;
            public modify::Modifier (p_oid : OID -> Denuncia, p_fecha : Date, p_estado : EstadoContenido, p_denunciante_oid : OID -> Usuario) : Void;
            public readOID::ReadOID (p_oid : OID -> Denuncia) : Object->Denuncia;
            public readAll::ReadAll () : List<Object->Denuncia>;
            public addDenunciado::Relationer -> UsuarioDenuncia.denunciado (p_oid : OID -> Denuncia, p_usuario_oid : OID -> Usuario) : Void;
            public addContenidoDenunciado::Relationer -> DenunciaContenido.contenidoDenunciado (p_oid : OID -> Denuncia, p_contenido_oid : OID -> Contenido) : Void;
            public aprobarDenuncia::Custom (p_oid : OID -> Denuncia) : Void;
            public rechazarDenuncia::Custom (p_oid : OID -> Denuncia) : Void;
        }
    };

    Class Valoracion extends Contenido
    {
        attributes
        {
            private puntuacion : Float (1, 1);
        }
        
        operations
        {
            public new::New (p_texto : String, p_fechaCreacion : Date, p_numeroMeGusta : Integer, p_puntuacion : Float, p_usuarioCreador_oid : OID -> Usuario, p_videojuego_oid : OID -> Videojuego) : Object->Valoracion;
            public destroy::Destroy (p_oid : OID -> Valoracion) : Void;
            public modify::Modifier (p_oid : OID -> Valoracion, p_texto : String, p_fechaCreacion : Date, p_numeroMeGusta : Integer, p_puntuacion : Float, p_usuarioCreador_oid : OID -> Usuario, p_videojuego_oid : OID -> Videojuego) : Void;
            public readOID::ReadOID (p_oid : OID -> Valoracion) : Object->Valoracion;
            public readAll::ReadAll () : List<Object->Valoracion>;
            public actualizarValoracion::CustomTransaction (p_oid : OID -> Valoracion, nuevo_valor : Float) : Void;
            public nuevaValoracion::CustomTransaction (p_oid : OID -> Valoracion) : Void;
            public eliminarValoracion::CustomTransaction (p_oid : OID -> Valoracion) : Void;

            public findByPuntuacion::ReadFilter (p_texto : String) : List<Object->Valoracion>
            {
                filterLinQ = "entity => entity.Texto == p_texto"
            };

            public findPeores::ReadFilter (p_texto : String) : List<Object->Valoracion>
            {
                filterLinQ = "entity => entity.Texto == p_texto"
            };

            public findMejores::ReadFilter (p_texto : String) : List<Object->Valoracion>
            {
                filterLinQ = "entity => entity.Texto == p_texto"
            };


        }
    };

    Class AccionSistema
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private fecha : Date (1, 1);
            private descripcion : String(1, 1);
        }
        
        operations
        {
            public new::New (p_fecha : Date, p_descripcion : String, p_causante_oid : OID -> Usuario, p_contenidoAfectado_oid : OID -> Contenido) : Object->AccionSistema;
            public destroy::Destroy (p_oid : OID -> AccionSistema) : Void;
            public modify::Modifier (p_oid : OID -> AccionSistema, p_fecha : Date, p_descripcion : String, p_causante_oid : OID -> Usuario, p_contenidoAfectado_oid : OID -> Contenido) : Void;
            public readOID::ReadOID (p_oid : OID -> AccionSistema) : Object->AccionSistema;
            public readAll::ReadAll () : List<Object->AccionSistema>;

            public findByFechaLinQ::ReadFilter (p_fecha : Date) : List<Object->AccionSistema>
            {
                filterLinQ = "entity => entity.Fecha == p_fecha"
            };
        }
    };

    Class Rechazo
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private fecha : Date(1,1);
            private motivo : String (1, 1);
        }
        
        operations
        {
            public new::New (p_fecha : Date, p_motivo : String, p_videojuego_oid : OID -> Videojuego, p_gestor_oid : OID -> Usuario) : Object->Rechazo;
            public destroy::Destroy (p_oid : OID -> Rechazo) : Void;
            public modify::Modifier (p_oid : OID -> Rechazo, p_fecha : Date, p_motivo : String, p_videojuego_oid : OID -> Videojuego, p_gestor_oid : OID -> Usuario) : Void;
            public readOID::ReadOID (p_oid : OID -> Rechazo) : Object->Rechazo;
            public readAll::ReadAll () : List<Object->Rechazo>;
        }
    };

    Class Contenido
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private texto : String (1, 1);
            private fechaCreacion : Date (1, 1);
            private numeroMeGusta : Integer(1, 1);
        }   
        
        operations
        {
            public newCustomized::New customized (p_texto : String, p_fechaCreacion : Date, p_usuarioCreador_oid : OID -> Usuario) : Object->Contenido;
            public destroy::Destroy (p_oid : OID -> Contenido) : Void;
            public modify::Modifier (p_oid : OID -> Contenido, p_texto : String, p_fechaCreacion : Date, p_numeroMeGusta : Integer, p_usuarioCreador_oid : OID -> Usuario) : Void;
            public readOID::ReadOID (p_oid : OID -> Contenido) : Object->Contenido;
            public readAll::ReadAll () : List<Object->Contenido>;
            public addDenuncia::Relationer -> DenunciaContenido.denuncias (p_oid : OID -> Contenido, p_denuncia_oids : List<OID -> Denuncia>) : Void;
            public darMeGusta::Custom (p_oid : OID -> Contenido, p_user : OID -> Usuario) : Void;
            public retirarMeGusta::Custom (p_oid : OID -> Contenido, p_user : OID -> Usuario) : Void;

            public findOrderByFecha::ReadFilter (p_texto : String) : List<Object->Contenido>
            {
                filterLinQ = "entity => entity.Texto == p_texto"
            };

            public findOrderMeGusta::ReadFilter (p_texto : String) : List<Object->Contenido>
            {
                filterLinQ = "entity => entity.Texto == p_texto"
            };

            public findBYUserLiked::ReadFilter (p_texto : String) : List<Object->Contenido>
            {
                filterLinQ = "entity => entity.Texto == p_texto"
            };
        }
    };

    Class Notificacion
    {
        attributes
        {
            private oid id : Autogenerated (1, 1);
            private texto : String(1, 1);
            private fecha : Date(1, 1);
        }
        
        operations
        {
            public new::New (p_texto : String, p_fecha : Date) : Object->Notificacion;
            public destroy::Destroy (p_oid : OID -> Notificacion) : Void;
            public modify::Modifier (p_oid : OID -> Notificacion, p_texto : String, p_fecha : Date) : Void;
            public readOID::ReadOID (p_oid : OID -> Notificacion) : Object->Notificacion;
            public readAll::ReadAll () : List<Object->Notificacion>;

            public findByFecha::ReadFilter (p_texto : String) : List<Object->Notificacion>
            {
                filterLinQ = "entity => entity.Texto == p_texto"
            };
        }
    };

    Association UsuarioContenido (Usuario - Contenido)
    {
        => navigable contenidoGenerado : Share (0, *);
        <= navigable usuarioCreador (1, 1);
    };


    Association VideojuegoTemaConversacion (Videojuego - TemaConversacion)
    {
        => navigable temas : Share (0, *);
        <= navigable videojuego (1, 1);
    };

    Association VideojuegoValoracion (Videojuego - Valoracion)
    {
        => navigable valoraciones : Composite (0, *);
        <= navigable videojuego (1, 1);
    };

    Association TemaConversacionComentario (TemaConversacion - Comentario)
    {
        => navigable comentarios : Share (0, *);
        <= navigable tema (1, 1);
    };

    Association VideojuegoRechazo (Videojuego - Rechazo)
    {
        => navigable rechazo (0, 1);
        <= navigable videojuego (1, 1);
    };

    Association ComentarioComentario (Comentario - Comentario)
    {
        => navigable respuestas (0, *);
        <= navigable comentarioAsociado (0, 1);
    };

    Association CategoriaCategoria (Categoria - Categoria)
    {
        => navigable hijos (0, *);
        <= navigable padre (0, 1);
    };

    Association VideojuegoCategoria (Videojuego - Categoria)
    {
        => navigable categorias (0, *);
        <= navigable videojuego (1, 1);
    };
    
    Association DenunciaNotificacion (Denuncia - Notificacion)
    {
        => navigable notificacion (0, 1);
        <= navigable denuncia (0, 1);
    };
    
    Association UsuarioRechazo (Usuario - Rechazo)
    {
        => navigable rechazos (0, *);
        <= navigable gestor (1, 1);
    };

    Association UsuarioAccionSistema (Usuario - AccionSistema)
    {
        => navigable acciones (0, *);
        <= navigable causante (1, 1);
    };

    Association AccionSistemaContenido (AccionSistema - Contenido)
    {
        => navigable contenidoAfectado (1, 1);
        <= navigable acciones (0, *);
    };
    
    Association NotificacionUsuario (Notificacion - Usuario)
    {
        => navigable notificados (0, *);
        <= navigable notificaciones (0, *);
    };

    Association DenunciaUsuario (Denuncia - Usuario)
    {
        => navigable denunciante (1, 1);
        <= navigable denunciasGeneradas (0, *);
    };
    
    Association UsuarioDenuncia (Usuario - Denuncia)
    {
        => navigable denunciasRecibidas (0, *);
        <= navigable denunciado (0, 1);
    };

    Association DenunciaContenido (Denuncia - Contenido)
    {
        => navigable contenidoDenunciado (0, 1);
        <= navigable denuncias (0, *);
    };
    
    Association UsuarioFavoritos (Usuario - Contenido)
    {
        => navigable contenidoFavorito : Share (0, *);
        <= navigable usuarioFavorito (0, *);
    };
}