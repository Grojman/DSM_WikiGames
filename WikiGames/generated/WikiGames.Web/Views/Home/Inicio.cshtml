@* MANUAL FILE (not generated by HARIA). Página principal, migrada desde WikiGames.HTML/index.html. *@
@model WikiGames.Web.ViewModels.Paginas.InicioViewModel
@using WikiGames.Web.ViewModels.Paginas
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Inicio";
    ViewData["Page"] = "home";
    var total = Model.Videojuegos.Count;
}

<main class="container">
    <form class="toolbar" method="get" asp-controller="Home" asp-action="Index" role="search" aria-label="Buscar y filtrar">
        <div class="search">
            <span data-icon="search"></span>
            <input id="q" name="q" value="@Model.Q" class="field" type="search" placeholder="Buscar videojuegos…" aria-label="Buscar videojuegos" autocomplete="off">
        </div>
        <div class="filters">
            <label>Ordenar por
                <select id="orden" name="orden" class="field" data-autosubmit>
                    <option value="@InicioViewModel.OrdenPopular" selected="@(Model.Orden == InicioViewModel.OrdenPopular)">Más popular</option>
                    <option value="@InicioViewModel.OrdenValorado" selected="@(Model.Orden == InicioViewModel.OrdenValorado)">Mejor valorado</option>
                    <option value="@InicioViewModel.OrdenRecientes" selected="@(Model.Orden == InicioViewModel.OrdenRecientes)">Recientes</option>
                </select>
            </label>
            <label>Categoría
                <select id="categoria" name="categoria" class="field" data-autosubmit>
                    <option value="">Todas las categorías</option>
                    @foreach (var c in Model.Categorias)
                    {
                        @* Las hijas se muestran indentadas bajo su padre. *@
                        <option value="@c.Id" selected="@(Model.Categoria == c.Id)">@(new string(' ', c.Nivel * 3))@c.Name</option>
                    }
                </select>
            </label>
        </div>
    </form>

    <p id="count" class="result-count" aria-live="polite">@total @(total == 1 ? "videojuego" : "videojuegos")</p>
    <section id="grid" class="game-grid" aria-label="Videojuegos disponibles">
        @if (total == 0)
        {
            <div class="empty" style="grid-column:1/-1">No hay videojuegos que coincidan con la búsqueda.</div>
        }
        @foreach (var v in Model.Videojuegos)
        {
            <a class="game-card" asp-controller="Videojuego" asp-action="Ficha" asp-route-id="@v.Id" title="@v.Titulo" aria-label="@v.Titulo">
                <partial name="WikiGames/_Cover" model="v" />
            </a>
        }
    </section>
</main>
