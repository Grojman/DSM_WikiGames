@* MANUAL FILE (not generated by HARIA). Migrada desde WikiGames.HTML/notificaciones.html. Usuario autenticado. *@
@model WikiGames.Web.ViewModels.Paginas.ListaNotificacionesViewModel
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Notificaciones";
    ViewData["Page"] = "notificaciones";
    var total = Model.Notificaciones.Count;
}

<main class="container narrow">
    <h1 class="page-title">Notificaciones</h1>

    <form class="toolbar" method="get" asp-controller="Notificacion" asp-action="Lista" role="search">
        <div class="search">
            <span data-icon="search"></span>
            <input id="q" name="q" value="@Model.Q" class="field" type="search" placeholder="Buscar en tus notificaciones…" aria-label="Buscar notificaciones" autocomplete="off">
        </div>
    </form>

    <p id="count" class="result-count" aria-live="polite">@total @(total == 1 ? "notificación" : "notificaciones")</p>

    <section id="list" class="admin-list" aria-label="Lista de notificaciones">
        @if (total == 0)
        {
            <div class="empty">No tienes notificaciones en este momento.</div>
        }
        @foreach (var n in Model.Notificaciones)
        {
            var destino = n.RechazoId is int rid
                ? Url.Action("Details", "Rechazo", new { id = rid })
                : Url.Action("Detalle", "Notificacion", new { id = n.Id });
            <article class="card report-card list-card" data-href="@destino" tabindex="0">
                <div class="report-main">
                    <span class="avatar"><span data-icon="@(n.RechazoId.HasValue || n.DenunciaId.HasValue ? "flag" : "bell")"></span></span>
                    <div>
                        <strong>@n.Texto</strong>
                        <div class="muted">
                            <time datetime="@n.Fecha.ToString("o")">@n.Fecha.ToString("dd MMM yyyy, HH:mm")</time> · Sistema WikiGames
                        </div>
                    </div>
                </div>
                <div class="report-actions">
                    @if (n.RechazoId is int rechazoId)
                    {
                        <a class="btn btn-sm btn-primary" asp-controller="Rechazo" asp-action="Details" asp-route-id="@rechazoId">Ver rechazo</a>
                        <a class="btn btn-sm" asp-controller="Notificacion" asp-action="Detalle" asp-route-id="@n.Id">Ver detalle</a>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-primary" asp-controller="Notificacion" asp-action="Detalle" asp-route-id="@n.Id">Ver detalle</a>
                    }
                    <form class="inline-form" method="post" asp-controller="Notificacion" asp-action="Eliminar" asp-route-id="@n.Id" asp-route-q="@Model.Q"
                          data-confirm-title="Eliminar notificación" data-confirm-ok="Eliminar" data-confirm="¿Eliminar esta notificación?">
                        <button type="submit" class="icon-btn btn-danger" title="Eliminar notificación" aria-label="Eliminar">
                            <span data-icon="trash"></span>
                        </button>
                    </form>
                </div>
            </article>
        }
    </section>
</main>
