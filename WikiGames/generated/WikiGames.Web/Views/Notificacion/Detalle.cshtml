@* MANUAL FILE (not generated by HARIA). Migrada desde WikiGames.HTML/notificacion.html. Usuario autenticado. *@
@model WikiGames.Web.ViewModels.Paginas.NotificacionItemViewModel
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Detalle de notificación";
    ViewData["Page"] = "notificacion";
}

<main class="container narrow">
    <a class="back-link" asp-controller="Notificacion" asp-action="Lista"><span data-icon="back"></span>Volver a notificaciones</a>

    <h1 class="page-title">Notificación</h1>

    <article class="card form-card" aria-label="Contenido de la notificación">
        <div class="review-head">
            <div class="review-author">
                <span class="avatar lg"><span data-icon="@(Model.RechazoId.HasValue || Model.DenunciaId.HasValue ? "flag" : "bell")"></span></span>
                <div>
                    <strong>Aviso del sistema</strong>
                    <div class="muted">
                        Recibida el <time datetime="@Model.Fecha.ToString("o")">@Model.Fecha.ToString("dd 'de' MMMM 'de' yyyy 'a las' HH:mm")</time>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group" style="margin-top: 16px;">
            <span class="label">Mensaje</span>
            <p class="review-text">@Model.Texto</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ElementoRelacionadoTitulo))
        {
            <div class="form-group">
                <span class="label">Elemento relacionado</span>
                <p class="hint">Esta notificación está asociada a:</p>
                @if (!string.IsNullOrWhiteSpace(Model.ElementoRelacionadoEnlace))
                {
                    <a class="chip" href="@Model.ElementoRelacionadoEnlace">
                        <span data-icon="@(Model.ElementoRelacionadoIcono ?? "gamepad")"></span>
                        <span>@Model.ElementoRelacionadoTitulo</span>
                    </a>
                }
                else
                {
                    <span class="chip">
                        <span data-icon="@(Model.ElementoRelacionadoIcono ?? "flag")"></span>
                        <span>@Model.ElementoRelacionadoTitulo</span>
                    </span>
                }
            </div>
        }

        <div class="form-actions">
            <a class="btn" asp-controller="Notificacion" asp-action="Lista">Volver</a>
            @if (Model.RechazoId is int rechazoId)
            {
                <a class="btn btn-primary" asp-controller="Rechazo" asp-action="Details" asp-route-id="@rechazoId">Ver detalle del rechazo</a>
            }
            <form class="inline-form" method="post" asp-controller="Notificacion" asp-action="Eliminar" asp-route-id="@Model.Id"
                  data-confirm-title="Eliminar notificación" data-confirm-ok="Eliminar" data-confirm="¿Eliminar esta notificación?">
                <button type="submit" class="btn btn-ghost btn-danger">
                    <span data-icon="trash"></span>Eliminar notificación
                </button>
            </form>
        </div>
    </article>
</main>
