@* MANUAL FILE (not generated by HARIA). Migrada desde WikiGames.HTML/me-gusta.html. Usuario autenticado. *@
@model WikiGames.Web.ViewModels.Paginas.ContenidoMeGustaViewModel
@using WikiGames.Web.ViewModels.Paginas
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Me gusta";
    ViewData["Page"] = "favoritos";
    var total = Model.Elementos.Count;
    var filtros = new (string Valor, string Texto)[]
    {
        (ContenidoMeGustaViewModel.TipoTodos, "Todos"),
        (ContenidoMeGustaViewModel.TipoVideojuegos, "Videojuegos"),
        (ContenidoMeGustaViewModel.TipoConversaciones, "Conversaciones"),
        (ContenidoMeGustaViewModel.TipoComentarios, "Comentarios"),
    };
}

<main class="container">
    <h1 class="page-title">Contenido con Me gusta</h1>

    <div class="center">
        <nav id="seg" class="seg" aria-label="Filtrar por tipo de contenido">
            @foreach (var f in filtros)
            {
                <a class="@(Model.Tipo == f.Valor ? "active" : "")"
                   asp-controller="Contenido" asp-action="MeGusta" asp-route-tipo="@f.Valor"
                   aria-current="@(Model.Tipo == f.Valor ? "page" : null)">@f.Texto</a>
            }
        </nav>
    </div>

    <p id="count" class="result-count" aria-live="polite">@total @(total == 1 ? "elemento guardado" : "elementos guardados")</p>

    <section id="list" class="admin-list" aria-label="Lista de contenidos con me gusta">
        @if (total == 0)
        {
            <div class="empty">Todavía no has marcado ningún contenido con Me gusta en esta categoría.</div>
        }
        @foreach (var item in Model.Elementos)
        {
            <article class="card report-card list-card @(item.Enlace is null ? "no-click" : "")" data-href="@item.Enlace" tabindex="@(item.Enlace is null ? null : "0")">
                <div class="report-main">
                    <span class="target"><span data-icon="heart"></span>@item.Tipo</span>
                    <div>
                        <h3 class="thread-title" style="font-size: 1.1em; margin: 0 0 4px;">
                            @if (item.Enlace is not null)
                            {
                                <a class="@(item.EsVideojuego ? "videogame-font" : "")" href="@item.Enlace">@item.Titulo</a>
                            }
                            else
                            {
                                <span class="@(item.EsVideojuego ? "videogame-font" : "")">@item.Titulo</span>
                            }
                        </h3>
                        <p class="muted" style="margin: 0;">
                            @if (!string.IsNullOrWhiteSpace(item.Descripcion))
                            {
                                <span>@item.Descripcion </span>
                            }
                            Creado por <strong>@(item.AutorNombre ?? "usuario eliminado")</strong>
                            @if (!string.IsNullOrWhiteSpace(item.AutorEmail))
                            {
                                <span> (@item.AutorEmail)</span>
                            }
                        </p>
                    </div>
                </div>
                <div class="report-actions">
                    @if (item.Enlace is not null)
                    {
                        <a class="btn btn-sm btn-primary" href="@item.Enlace">Ver contenido</a>
                    }
                    <form class="inline-form" method="post" asp-controller="Contenido" asp-action="QuitarMeGusta" asp-route-id="@item.ContenidoId" asp-route-tipo="@Model.Tipo">
                        <button type="submit" class="btn btn-sm btn-ghost" title="Quitar me gusta">
                            <span data-icon="x"></span>Quitar
                        </button>
                    </form>
                </div>
            </article>
        }
    </section>
</main>
