@model WikiGames.Web.ViewModels.UsuarioViewModel

@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Crear";
}

<main class="container narrow">
        <h1 class="page-title">Crear cuenta</h1>
    <div class="card form-card">
    <form asp-action="Register" method="post">
        <br><br><input asp-for="Name" type="text" placeholder="Usuario" class="field" required>
        <br><br><input asp-for="Email" type="email" placeholder="Email" class="field" required>
        <br><br><input asp-for="Password" type="password" placeholder="Contraseña" class="field" id="ps1" required><button type="button" onclick="ver('ps1', 'img1')"><img id="img1" src="iconos/visibility.svg" alt=""></button>
        <br><br><input asp-for="RolUsuario" type="number" placeholder="Rol" class="field" required step="1" min="1" max="3">
        <br><br><input type="submit">
    </form>
    </div>
    </main>
    <script src="js/common.js"></script>
    <script src="js/data.js"></script>
    <script>
        function ver(id , idimg){
            let ps = document.getElementById(id);
            let img = document.getElementById(idimg);
            if (ps.type == "password") {
                ps.type = "text";
                img.src = "iconos/visibility_off.svg"
            }else{
                ps.type = "password";
                img.src = "iconos/visibility.svg"
            }
        }
    </script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />


}
