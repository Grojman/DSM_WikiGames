@* MANUAL FILE (not generated by HARIA). Ajustes de la cuenta: cambio de contraseña. *@
@model WikiGames.Web.ViewModels.Paginas.AjustesViewModel
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Ajustes";
    ViewData["Page"] = "ajustes";
    string? Error(string campo) => ViewData.ModelState[campo]?.Errors.FirstOrDefault()?.ErrorMessage;
    string Invalido(string campo) => Error(campo) is null ? "" : "invalid";
}

<main class="container narrow">
    <h1 class="page-title">Ajustes</h1>

    <form id="form" class="card form-card" method="post" asp-controller="Usuario" asp-action="Ajustes" novalidate>
        <h2 class="label">Cambiar contraseña</h2>
        <div asp-validation-summary="ModelOnly"></div>

        <div class="form-group">
            <label class="label" for="actual">Contraseña actual <span class="req" aria-hidden="true">*</span></label>
            <input asp-for="PasswordActual" id="actual" class="field @Invalido(nameof(Model.PasswordActual))" type="password" autocomplete="current-password" required aria-required="true" aria-describedby="actual-error">
            <p class="error-msg" id="actual-error">@(Error(nameof(Model.PasswordActual)) ?? "Indica tu contraseña actual.")</p>
        </div>

        <div class="form-group">
            <label class="label" for="nueva">Nueva contraseña <span class="req" aria-hidden="true">*</span></label>
            <input asp-for="PasswordNueva" id="nueva" class="field @Invalido(nameof(Model.PasswordNueva))" type="password" autocomplete="new-password" minlength="4" maxlength="128" required aria-required="true" aria-describedby="nueva-error">
            <p class="error-msg" id="nueva-error">@(Error(nameof(Model.PasswordNueva)) ?? "La nueva contraseña debe tener al menos 4 caracteres.")</p>
        </div>

        <div class="form-group">
            <label class="label" for="confirmacion">Repetir nueva contraseña <span class="req" aria-hidden="true">*</span></label>
            <input asp-for="PasswordConfirmacion" id="confirmacion" class="field @Invalido(nameof(Model.PasswordConfirmacion))" type="password" autocomplete="new-password" required aria-required="true" aria-describedby="confirmacion-error">
            <p class="error-msg" id="confirmacion-error">@(Error(nameof(Model.PasswordConfirmacion)) ?? "Las contraseñas no coinciden.")</p>
        </div>

        <div class="form-actions">
            <a class="btn btn-ghost" asp-controller="Home" asp-action="Index">Cancelar</a>
            <button class="btn btn-primary" type="submit">Cambiar contraseña</button>
        </div>
    </form>
</main>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const $form = document.getElementById("form");
            const $actual = document.getElementById("actual");
            const $nueva = document.getElementById("nueva");
            const $conf = document.getElementById("confirmacion");
            const marcar = ($el, invalido) => $el.classList.toggle("invalid", invalido);

            [$actual, $nueva, $conf].forEach(($el) => $el.addEventListener("input", () => marcar($el, false)));
            $form.addEventListener("submit", (e) => {
                const errores = [
                    [$actual, !$actual.value],
                    [$nueva, $nueva.value.length < 4],
                    [$conf, !$conf.value || $conf.value !== $nueva.value],
                ];
                errores.forEach(([$el, invalido]) => marcar($el, invalido));
                const primero = errores.find(([, invalido]) => invalido);
                if (primero) { e.preventDefault(); primero[0].focus(); }
            });
        });
    </script>
}
