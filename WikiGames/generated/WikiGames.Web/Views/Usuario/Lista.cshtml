@* MANUAL FILE (not generated by HARIA). Migrada desde WikiGames.HTML/admin-usuarios.html. Solo administradores. *@
@model WikiGames.Web.ViewModels.Paginas.ListaUsuariosViewModel
@using WikiGames.Domain.Enums
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Usuarios";
    ViewData["Page"] = "admin-usuarios";
    var total = Model.Usuarios.Count;
}

<main class="container">
    <div class="center"><span class="admin-badge">Solo administradores</span></div>
    <h1 class="page-title">Usuarios</h1>

    <form class="toolbar" method="get" asp-controller="Usuario" asp-action="Lista" role="search">
        <div class="search">
            <span data-icon="search"></span>
            <input id="q" name="q" value="@Model.Q" class="field" type="search" placeholder="Buscar usuarios por nombre…" aria-label="Buscar usuarios" autocomplete="off">
        </div>
    </form>

    <p id="count" class="result-count" aria-live="polite">@total @(total == 1 ? "usuario" : "usuarios")</p>
    <section id="list" class="admin-list" aria-label="Lista de usuarios">
        @if (total == 0)
        {
            <div class="empty">Ningún usuario coincide con la búsqueda.</div>
        }
        @foreach (var u in Model.Usuarios)
        {
            var nj = u.NumeroVideojuegos;
            var nd = u.NumeroDenunciasRecibidas;
            var fijo = u.RolUsuario == Rol.Administrador || u.Id == Model.AdministradorActualId;
            <article class="card user-card">
                <partial name="WikiGames/_Avatar" model="u.Name" view-data='new ViewDataDictionary(ViewData) { ["Size"] = "lg" }' />
                <div class="name" title="@u.Name">@u.Name<div class="muted">#@u.Id</div></div>
                <div class="stat s-games"><b>@nj</b><small>@(nj == 1 ? "juego" : "juegos")</small></div>
                <div class="stat s-reports @(nd > 0 ? "alert" : "")" title="Denuncias en las que es el usuario denunciado"><b>@nd</b><small>@(nd == 1 ? "denuncia" : "denuncias")</small></div>
                @if (fijo)
                {
                    <span class="role-fixed">@(u.RolUsuario == Rol.Administrador ? "Administrador" : u.RolUsuario == Rol.Moderador ? "Moderador" : "Normal")</span>
                }
                else
                {
                    @* Usuario.modify: el rol cambia al elegir otra opción. *@
                    <form class="inline-form" method="post" asp-controller="Usuario" asp-action="CambiarRol" asp-route-id="@u.Id" asp-route-q="@Model.Q">
                        <select class="field" name="rol" data-autosubmit aria-label="Rol de @u.Name">
                            <option value="@Rol.Registrado" selected="@(u.RolUsuario == Rol.Registrado)">Normal</option>
                            <option value="@Rol.Moderador" selected="@(u.RolUsuario == Rol.Moderador)">Moderador</option>
                        </select>
                    </form>
                }
                @* UsuarioUseCase.destroy *@
                <form class="inline-form" method="post" asp-controller="Usuario" asp-action="Eliminar" asp-route-id="@u.Id" asp-route-q="@Model.Q"
                      data-confirm="¿Eliminar al usuario «@u.Name»? Esta acción no se puede deshacer.">
                    <button class="icon-btn btn-danger" type="submit" data-del="@u.Id" disabled="@fijo" title="Eliminar usuario" aria-label="Eliminar a @u.Name"><span data-icon="trash"></span></button>
                </form>
            </article>
        }
    </section>
</main>
