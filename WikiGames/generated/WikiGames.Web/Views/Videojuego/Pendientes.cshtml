@* MANUAL FILE (not generated by HARIA). Migrada desde WikiGames.HTML/videojuegos-pendientes.html. Moderadores y administradores. *@
@model WikiGames.Web.ViewModels.Paginas.VideojuegosPendientesViewModel
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Videojuegos pendientes";
    ViewData["Page"] = "pendientes";
    var total = Model.Videojuegos.Count;
}

<main class="container">
    <div class="center"><span class="admin-badge">Administradores y moderadores</span></div>
    <h1 class="page-title">Videojuegos pendientes de aprobación</h1>

    <form class="toolbar" method="get" asp-controller="Videojuego" asp-action="Pendientes" role="search">
        <div class="search">
            <span data-icon="search"></span>
            <input id="q" name="q" value="@Model.Q" class="field" type="search" placeholder="Buscar propuestas por título o autor…" aria-label="Buscar propuestas" autocomplete="off">
        </div>
    </form>

    <p id="count" class="result-count" aria-live="polite">@total @(total == 1 ? "videojuego pendiente" : "videojuegos pendientes")</p>

    <section id="list" class="admin-list" aria-label="Lista de videojuegos pendientes">
        @if (total == 0)
        {
            <div class="empty">No hay videojuegos pendientes de aprobación.</div>
        }
        @foreach (var item in Model.Videojuegos)
        {
            var v = item.Videojuego;
            <article class="card report-card list-card no-click">
                <div class="report-main">
                    <span class="target"><span data-icon="gamepad"></span>Pendiente</span>
                    <div>
                        <h3 class="thread-title" style="font-size: 1.15em; margin: 0 0 4px;">
                            <a class="videogame-font" asp-controller="Videojuego" asp-action="Ficha" asp-route-id="@v.Id">@v.Titulo</a>
                        </h3>
                        <p class="muted" style="margin: 0 0 6px;">@(string.IsNullOrWhiteSpace(v.Texto) ? "Sin descripción." : v.Texto)</p>
                        <div class="thread-meta" style="margin-top: 0; flex-wrap: wrap;">
                            <partial name="WikiGames/_Avatar" model="v.UsuarioCreadorLabel" />
                            <span>
                                @(v.UsuarioCreadorLabel ?? "usuario eliminado")
                                @if (!string.IsNullOrWhiteSpace(item.AutorEmail))
                                {
                                    <span> (@item.AutorEmail)</span>
                                }
                            </span>
                            <span aria-hidden="true">·</span>
                            <time datetime="@v.FechaCreacion.ToString("o")">@v.FechaCreacion.ToString("dd MMM yyyy")</time>
                            @foreach (var c in v.Categorias)
                            {
                                <span aria-hidden="true">·</span>
                                <span class="chip">@c.Name</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="report-actions">
                    <a class="btn btn-sm" asp-controller="Videojuego" asp-action="Ficha" asp-route-id="@v.Id">Revisar ficha</a>
                    <form class="inline-form" method="post" asp-controller="Videojuego" asp-action="Aprobar" asp-route-id="@v.Id" asp-route-q="@Model.Q">
                        <button type="submit" class="btn btn-sm btn-primary" title="Aprobar">
                            <span data-icon="check"></span>Aprobar
                        </button>
                    </form>
                    <button type="button" class="btn btn-sm" data-toggle-reject="reject-@v.Id" title="Rechazar">
                        <span data-icon="x"></span>Rechazar
                    </button>
                </div>
                <form id="reject-@v.Id" class="pending-reject" method="post" asp-controller="Videojuego" asp-action="Rechazar" asp-route-id="@v.Id" asp-route-q="@Model.Q" hidden>
                    <label class="sr-only" for="motivo-@v.Id">Motivo de rechazo para @v.Titulo</label>
                    <input id="motivo-@v.Id" name="motivo" class="field" type="text" required placeholder="Indica el motivo del rechazo…">
                    <button type="submit" class="btn btn-sm btn-danger"><span data-icon="x"></span>Confirmar rechazo</button>
                </form>
            </article>
        }
    </section>
</main>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll("[data-toggle-reject]").forEach((btn) => {
                btn.addEventListener("click", () => {
                    const form = document.getElementById(btn.dataset.toggleReject);
                    if (!form) return;
                    form.hidden = !form.hidden;
                    if (!form.hidden) form.querySelector("input[name='motivo']")?.focus();
                });
            });
        });
    </script>
}
