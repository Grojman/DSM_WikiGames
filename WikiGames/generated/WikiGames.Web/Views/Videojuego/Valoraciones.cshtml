@* MANUAL FILE (not generated by HARIA). Migrada desde WikiGames.HTML/comentarios.html (valoraciones del juego). *@
@model WikiGames.Web.ViewModels.Paginas.ValoracionesJuegoViewModel
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = $"Comentarios · {Model.Videojuego.Titulo}";
    ViewData["Page"] = "comentarios";
    var autenticado = User.Identity?.IsAuthenticated == true;
}

<main class="container narrow">
    <partial name="WikiGames/_GameHeader" model="Model.Videojuego" view-data='new ViewDataDictionary(ViewData) { ["Tab"] = "comentarios" }' />

    <h2 class="page-title">Comentarios</h2>

    @if (autenticado)
    {
        <form id="review-form" class="card review-form" method="post" asp-controller="Videojuego" asp-action="Valorar" asp-route-id="@Model.Videojuego.Id">
            <div asp-validation-summary="All"></div>
            <label asp-for="Nueva.Texto" class="sr-only">Tu comentario</label>
            <textarea asp-for="Nueva.Texto" id="texto" class="field" placeholder="¿Qué te ha parecido la demo? Cuéntaselo a los desarrolladores…" maxlength="1000"></textarea>
            <input type="hidden" asp-for="Nueva.Estrellas" id="estrellas">
            <div class="review-form-footer">
                <div class="rating-label">
                    <span class="muted" id="rating-text">Tu puntuación</span>
                    <div id="star-input" class="star-input" role="radiogroup" aria-labelledby="rating-text"></div>
                </div>
                <button id="submit" class="btn btn-primary" type="submit" disabled>Publicar comentario</button>
            </div>
        </form>
    }
    else
    {
        <div class="card login-hint">
            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path)">Inicia sesión</a> para valorar este juego.
        </div>
    }

    <section id="list" class="review-list" aria-label="Lista de comentarios">
        @if (Model.Valoraciones.Count == 0)
        {
            <div class="empty">Todavía no hay comentarios. ¡Sé el primero en valorar este juego!</div>
        }
        @foreach (var v in Model.Valoraciones)
        {
            <article class="card review-card">
                <header class="review-head">
                    <div class="review-author"><partial name="WikiGames/_Avatar" model="v.UsuarioCreadorLabel" /><span>@(v.UsuarioCreadorLabel ?? "usuario eliminado")</span></div>
                    <partial name="WikiGames/_Stars" model="v.Puntuacion" />
                </header>
                <p class="review-text">@v.Texto</p>
                <time class="review-date" datetime="@v.FechaCreacion.ToString("o")">@v.FechaCreacion.ToString("dd MMM yyyy")</time>
            </article>
        }
    </section>
</main>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const $form = document.getElementById("review-form");
            if (!$form) return;
            const $texto = document.getElementById("texto");
            const $submit = document.getElementById("submit");
            const $stars = document.getElementById("star-input");
            const $estrellas = document.getElementById("estrellas");
            let rating = Number($estrellas.value) || 0;

            // Selector de 5 estrellas (cada estrella = 2 puntos en Valoracion.puntuacion, escala 0–10).
            for (let i = 1; i <= 5; i++) {
                const b = document.createElement("button");
                b.type = "button";
                b.innerHTML = UI.STAR;
                b.setAttribute("role", "radio");
                b.setAttribute("aria-label", `${i} ${i === 1 ? "estrella" : "estrellas"}`);
                b.addEventListener("click", () => { rating = i; paint(); validate(); });
                $stars.appendChild(b);
            }
            function paint() {
                $estrellas.value = rating;
                [...$stars.children].forEach((b, idx) => {
                    b.classList.toggle("on", idx < rating);
                    b.setAttribute("aria-checked", String(idx + 1 === rating));
                });
            }

            const validate = () => ($submit.disabled = !(rating > 0 && $texto.value.trim()));
            $texto.addEventListener("input", validate);
            $form.addEventListener("submit", (e) => { if ($submit.disabled) e.preventDefault(); });
            paint();
            validate();
        });
    </script>
}
