@* MANUAL FILE (not generated by HARIA). Migrada desde WikiGames.HTML/videojuego.html. *@
@model WikiGames.Web.ViewModels.Paginas.FichaVideojuegoViewModel
@using WikiGames.Domain.Enums
@{
    var v = Model.Videojuego;
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = v.Titulo;
    ViewData["Page"] = "videojuego";

    var estadoTexto = v.Estado switch
    {
        EstadoContenido.Aprobado => "Aprobado",
        EstadoContenido.Pendiente => "Pendiente de revisión",
        EstadoContenido.Rechazado => "Rechazado",
        _ => v.Estado.ToString(),
    };
}

<main class="container narrow">
    <partial name="WikiGames/_GameHeader" model="v" view-data='new ViewDataDictionary(ViewData) { ["Tab"] = "ficha" }' />

    <section class="card form-card" aria-label="Detalles de la ficha">
        <div class="review-head">
            <div class="review-author">
                <partial name="WikiGames/_Avatar" model="v.UsuarioCreadorLabel" view-data='new ViewDataDictionary(ViewData) { ["Size"] = "lg" }' />
                <div>
                    <strong>@(v.UsuarioCreadorLabel ?? "usuario eliminado")</strong>
                    <div class="muted">
                        @if (!string.IsNullOrWhiteSpace(Model.AutorEmail))
                        {
                            <span>@Model.AutorEmail · </span>
                        }
                        Publicado el <time datetime="@v.FechaCreacion.ToString("o")">@v.FechaCreacion.ToString("dd MMM yyyy")</time>
                    </div>
                </div>
            </div>
            <div class="rating-label">
                <partial name="WikiGames/_Stars" model="v.PuntuacionMedia" />
                <span><strong>@v.PuntuacionMedia.ToString("0.##")</strong> / 10</span>
            </div>
        </div>

        <div class="form-group" style="margin-top: 20px;">
            <span class="label">Descripción completa</span>
            <p class="review-text">@(string.IsNullOrWhiteSpace(v.Texto) ? "Sin descripción disponible." : v.Texto)</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(v.Enlace))
        {
            <div class="form-group">
                <span class="label">Página oficial o tienda</span>
                <p style="margin: 0;">
                    <a class="btn btn-sm" href="@v.Enlace" target="_blank" rel="noopener noreferrer">Visitar enlace externo</a>
                </p>
            </div>
        }

        @if (v.Estado == EstadoContenido.Rechazado && Model.RechazoId is int rechazoId)
        {
            <div class="card form-card sub-panel" aria-label="Información del rechazo">
                <h3>Propuesta rechazada</h3>
                <p class="review-text">@Model.RechazoMotivo</p>
                <p class="hint">
                    @if (!string.IsNullOrWhiteSpace(Model.RechazoGestor))
                    {
                        <span>Revisado por <strong>@Model.RechazoGestor</strong></span>
                    }
                    @if (Model.RechazoFecha is DateTime fechaRechazo)
                    {
                        <span> · @fechaRechazo.ToString("dd MMM yyyy")</span>
                    }
                </p>
                <div class="form-actions">
                    <a class="btn btn-sm" asp-controller="Rechazo" asp-action="Details" asp-route-id="@rechazoId">Ver detalle del rechazo</a>
                </div>
            </div>
        }

        @* Acciones públicas para usuarios autenticados *@
        @if (Model.EstaAutenticado)
        {
            <div class="form-actions ficha-actions" aria-label="Acciones públicas">
                <form class="inline-form" method="post" asp-controller="Videojuego" asp-action="AlternarMeGusta" asp-route-id="@v.Id">
                    <button type="submit" class="btn @(Model.TieneMeGusta ? "btn-active" : "")" title="@(Model.TieneMeGusta ? "Quitar me gusta" : "Dar me gusta")">
                        <span data-icon="heart"></span>
                        <span>@v.NumeroMeGusta Me gusta</span>
                    </button>
                </form>

                <form class="inline-form" method="post" asp-controller="Videojuego" asp-action="AlternarFavorito" asp-route-id="@v.Id">
                    <button type="submit" class="btn @(Model.EsFavorito ? "btn-active" : "")" title="@(Model.EsFavorito ? "Quitar de favoritos" : "Añadir a favoritos")">
                        <span data-icon="@(Model.EsFavorito ? "check" : "plus")"></span>
                        <span>@(Model.EsFavorito ? "En favoritos" : "Favorito")</span>
                    </button>
                </form>

                <form class="inline-form" method="post" asp-controller="Videojuego" asp-action="Denunciar" asp-route-id="@v.Id"
                      data-confirm-title="Denunciar publicación" data-confirm-ok="Enviar denuncia" data-confirm-icon="flag"
                      data-confirm="¿Enviar una denuncia sobre «@v.Titulo» para que la revise un moderador?">
                    <button type="submit" class="btn btn-ghost" disabled="@Model.YaDenunciado" title="Denunciar publicación">
                        <span data-icon="flag"></span>
                        <span>@(Model.YaDenunciado ? "Denunciado" : "Denunciar")</span>
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="card login-hint" style="margin: 20px 0 0;">
                <span><strong>@v.NumeroMeGusta</strong> Me gusta · </span>
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Inicia sesión</a>
                <span> para dar Me gusta, guardar en favoritos o denunciar esta ficha.</span>
            </div>
        }

        @* Opciones adicionales si quien visualiza es el DUEÑO / AUTOR *@
        @if (Model.EsDueno)
        {
            <div class="card form-card sub-panel" aria-label="Opciones del autor">
                <h3>Opciones de autor</h3>
                <p class="hint">Eres el creador de esta publicación. Estado: <strong>@estadoTexto</strong></p>
                <div class="form-actions">
                    <a class="btn" asp-controller="Videojuego" asp-action="Editar" asp-route-id="@v.Id">
                        <span data-icon="settings"></span>Editar videojuego
                    </a>
                    <form class="inline-form" method="post" asp-controller="Videojuego" asp-action="EliminarFicha" asp-route-id="@v.Id"
                          data-confirm-title="Eliminar videojuego" data-confirm-ok="Eliminar"
                          data-confirm="¿Eliminar tu videojuego «@v.Titulo»? Esta acción no se puede deshacer.">
                        <button type="submit" class="btn btn-ghost btn-danger">
                            <span data-icon="trash"></span>Eliminar videojuego
                        </button>
                    </form>
                </div>
            </div>
        }

        @* Opciones adicionales si quien visualiza es MODERADOR o ADMINISTRADOR *@
        @if (Model.EsModerador)
        {
            <div class="card form-card sub-panel" aria-label="Herramientas de moderación">
                <div class="center"><span class="admin-badge">Panel de moderación</span></div>
                <h3>Gestión de la publicación</h3>
                <p class="hint">Estado actual en la plataforma: <strong>@estadoTexto</strong></p>

                @if (v.Estado == EstadoContenido.Pendiente)
                {
                    <form id="form-rechazar" method="post" asp-controller="Videojuego" asp-action="Rechazar" asp-route-id="@v.Id" asp-route-origen="ficha">
                        <div class="form-group">
                            <label class="label" for="motivo-rechazo">Motivo de rechazo (requerido si se rechaza)</label>
                            <input id="motivo-rechazo" name="motivo" class="field" type="text" required placeholder="Ejemplo: Ficha incompleta o enlace inválido…">
                        </div>
                    </form>
                }

                <div class="form-actions">
                    @if (v.Estado == EstadoContenido.Pendiente)
                    {
                        <form class="inline-form" method="post" asp-controller="Videojuego" asp-action="Aprobar" asp-route-id="@v.Id" asp-route-origen="ficha">
                            <button type="submit" class="btn btn-primary">
                                <span data-icon="check"></span>Aprobar videojuego
                            </button>
                        </form>
                        <button type="submit" form="form-rechazar" class="btn">
                            <span data-icon="x"></span>Rechazar con motivo
                        </button>
                    }
                    <form class="inline-form" method="post" asp-controller="Videojuego" asp-action="EliminarFicha" asp-route-id="@v.Id"
                          data-confirm-title="Eliminar por infracción" data-confirm-ok="Eliminar"
                          data-confirm="¿Eliminar «@v.Titulo» por infracción? Esta acción no se puede deshacer.">
                        <button type="submit" class="btn btn-ghost btn-danger">
                            <span data-icon="trash"></span>Eliminar por infracción
                        </button>
                    </form>
                </div>
            </div>
        }
    </section>
</main>
