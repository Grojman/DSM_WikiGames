@model WikiGames.Web.ViewModels.VideojuegoViewModel

@{
    ViewData["Title"] = "Editar";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">Editar</span>
                <h1 class="h3 mb-1">Videojuego</h1>
                <p class="text-body-secondary mb-0">Completa los campos y guarda los cambios.</p>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
                    <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Titulo" class="form-label"></label>
            <input asp-for="Titulo" class="form-control" />
            <span asp-validation-for="Titulo" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Enlace" class="form-label"></label>
            <input asp-for="Enlace" class="form-control" />
            <span asp-validation-for="Enlace" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Imagen" class="form-label"></label>
            <input asp-for="Imagen" class="form-control" />
            <span asp-validation-for="Imagen" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Estado" class="form-label"></label>
            <select asp-for="Estado" asp-items="Html.GetEnumSelectList<WikiGames.Domain.Enums.EstadoContenido>()" class="form-select"></select>
            <span asp-validation-for="Estado" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PuntuacionMedia" class="form-label"></label>
            <input asp-for="PuntuacionMedia" type="text" inputmode="decimal" asp-format="{0:G}" data-haria-number="true" data-haria-decimal="@System.Globalization.CultureInfo.CurrentCulture.NumberFormat.NumberDecimalSeparator" class="form-control" />
            <span asp-validation-for="PuntuacionMedia" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Texto" class="form-label"></label>
            <input asp-for="Texto" class="form-control" />
            <span asp-validation-for="Texto" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="FechaCreacion" class="form-label"></label>
            <input asp-for="FechaCreacion" type="date" class="form-control" />
            <span asp-validation-for="FechaCreacion" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NumeroMeGusta" class="form-label"></label>
            <input asp-for="NumeroMeGusta" class="form-control" />
            <span asp-validation-for="NumeroMeGusta" class="text-danger"></span>
        </div>
        <partial name="_Valoraciones" model="Model" />
        <div class="mb-3">
            <label asp-for="RechazoId" class="form-label"></label>
            <select asp-for="RechazoId" asp-items="Model.RechazoOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="RechazoId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="UsuarioCreadorId" class="form-label"></label>
            <select asp-for="UsuarioCreadorId" asp-items="Model.UsuarioCreadorOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="UsuarioCreadorId" class="text-danger"></span>
        </div>
                </div>
                <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/haria-numbers.js" asp-append-version="true"></script>
    <script src="~/js/haria-compositions.js" asp-append-version="true"></script>
}
