@* MANUAL FILE (not generated by HARIA). Edición de ficha de videojuego desde Videojuego/Ficha. *@
@model WikiGames.Web.ViewModels.Paginas.EditarVideojuegoViewModel
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = $"Editar · {Model.Titulo}";
    ViewData["Page"] = "videojuego";
    var tituloInvalido = ViewData.ModelState[nameof(Model.Titulo)]?.Errors.Count > 0;
    var categoriasJson = Model.Categorias.Select(c => new { id = c.Id, name = c.Name, padre = c.PadreName ?? "" });
}

<main class="container narrow">
    <a class="back-link" asp-controller="Videojuego" asp-action="Ficha" asp-route-id="@Model.Id"><span data-icon="back"></span>Volver a la ficha</a>
    <h1 class="page-title">Editar videojuego</h1>

    <form id="form" class="card form-card" method="post" enctype="multipart/form-data" asp-controller="Videojuego" asp-action="Editar" asp-route-id="@Model.Id" novalidate>
        <div asp-validation-summary="ModelOnly"></div>

        <div class="form-group">
            <label class="label" for="titulo">Título <span class="req" aria-hidden="true">*</span></label>
            <input asp-for="Titulo" id="titulo" class="field @(tituloInvalido ? "invalid" : "")" type="text" maxlength="120" required aria-required="true" aria-describedby="titulo-error" placeholder="Nombre de tu videojuego">
            <p class="error-msg" id="titulo-error">@(ViewData.ModelState[nameof(Model.Titulo)]?.Errors.FirstOrDefault()?.ErrorMessage ?? "El título es obligatorio.")</p>
        </div>

        <div class="form-group">
            <label class="label" for="texto">Descripción</label>
            <textarea asp-for="Texto" id="texto" class="field" rows="5" placeholder="Cuenta de qué trata, qué incluye la demo y qué tipo de feedback buscas…"></textarea>
        </div>

        <div class="form-group">
            <span class="label" id="imagen-label">Imagen</span>
            <label id="dropzone" class="dropzone">
                <input asp-for="Imagen" id="imagen" type="file" accept="image/png, image/jpeg" aria-labelledby="imagen-label">
                <div id="dz-content">
                    @if (!string.IsNullOrWhiteSpace(Model.ImagenActual))
                    {
                        <img src="@Url.Content(Model.ImagenActual)" alt="@Model.Titulo" onerror="this.style.display='none'">
                        <div class="hint">Haz clic o arrastra una nueva imagen PNG o JPEG para reemplazarla</div>
                    }
                    else
                    {
                        <span data-icon="image"></span>
                        <div><strong>Haz clic</strong> o arrastra una imagen</div>
                        <div class="hint">PNG o JPEG</div>
                    }
                </div>
            </label>
            <span asp-validation-for="Imagen" class="hint"></span>
        </div>

        <div class="form-group">
            <label class="label" for="enlace">Enlace externo</label>
            <input asp-for="Enlace" id="enlace" class="field" type="url" inputmode="url" placeholder="https://tu-estudio.com/juego">
            <p class="hint">Opcional. Web del estudio, página de itch.io, Steam…</p>
            <span asp-validation-for="Enlace" class="hint"></span>
        </div>

        <div class="form-group">
            <label class="label" for="cat-q">Categorías</label>
            <div class="cat-picker">
                <div class="search">
                    <span data-icon="search"></span>
                    <input id="cat-q" class="field" type="search" placeholder="Buscar categorías…" autocomplete="off"
                           role="combobox" aria-expanded="false" aria-controls="cat-results" aria-autocomplete="list">
                </div>
                <div id="cat-results" class="cat-results" role="listbox" hidden></div>
            </div>
            <div id="cat-selected" class="cat-selected" aria-label="Categorías seleccionadas" aria-live="polite"></div>
            <div id="cat-hidden" hidden></div>
            <p class="hint">Pulsa sobre una categoría añadida para quitarla.</p>
            <span asp-validation-for="CategoriaIds" class="hint"></span>
        </div>

        <div class="form-actions">
            <a class="btn btn-ghost" asp-controller="Videojuego" asp-action="Ficha" asp-route-id="@Model.Id">Cancelar</a>
            <button class="btn btn-primary" type="submit">Guardar cambios</button>
        </div>
    </form>
</main>

<script type="application/json" id="cat-data">@Json.Serialize(categoriasJson)</script>
<script type="application/json" id="cat-initial">@Json.Serialize(Model.CategoriaIds)</script>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const CATEGORIAS = UI.readJson("cat-data", []);
            const $form = document.getElementById("form");
            const $titulo = document.getElementById("titulo");

            const $file = document.getElementById("imagen");
            const $dz = document.getElementById("dropzone");
            const $dzContent = document.getElementById("dz-content");
            const dzDefault = $dzContent.innerHTML;
            function showPreview(file) {
                if (!file || !/^image\/(png|jpeg)$/.test(file.type)) {
                    $dzContent.innerHTML = dzDefault;
                    if (file) { UI.toast("Solo se admiten imágenes PNG o JPEG"); $file.value = ""; }
                    return;
                }
                const url = URL.createObjectURL(file);
                $dzContent.innerHTML = `<img src="${url}" alt="Vista previa"><div class="hint">${UI.esc(file.name)} · haz clic para cambiarla</div>`;
            }
            $file.addEventListener("change", () => showPreview($file.files[0]));
            ["dragenter", "dragover"].forEach((ev) => $dz.addEventListener(ev, (e) => { e.preventDefault(); $dz.classList.add("drag"); }));
            ["dragleave", "drop"].forEach((ev) => $dz.addEventListener(ev, () => $dz.classList.remove("drag")));
            $dz.addEventListener("drop", (e) => {
                e.preventDefault();
                if (e.dataTransfer.files.length) { $file.files = e.dataTransfer.files; showPreview($file.files[0]); }
            });

            const $q = document.getElementById("cat-q");
            const $results = document.getElementById("cat-results");
            const $selected = document.getElementById("cat-selected");
            const $hidden = document.getElementById("cat-hidden");
            const selected = new Set(UI.readJson("cat-initial", []).filter((id) => CATEGORIAS.some((c) => c.id === id)));
            let focusIdx = -1;
            const norm = (s) => s.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

            function matches() {
                const q = norm($q.value.trim());
                return CATEGORIAS
                    .filter((c) => !selected.has(c.id) && (!q || norm(c.name).includes(q)))
                    .sort((a, b) => a.name.localeCompare(b.name, "es"));
            }
            function openResults() {
                const list = matches();
                focusIdx = -1;
                $results.innerHTML = list.length
                    ? list.map((c) => `<button type="button" class="cat-option" role="option" data-id="${c.id}"><span>${UI.esc(c.name)}</span><small>${UI.esc(c.padre)}</small></button>`).join("")
                    : `<div class="cat-option muted">Sin resultados</div>`;
                $results.hidden = false;
                $q.setAttribute("aria-expanded", "true");
            }
            function closeResults() { $results.hidden = true; $q.setAttribute("aria-expanded", "false"); }
            function renderSelected() {
                const cats = [...selected].map((id) => CATEGORIAS.find((c) => c.id === id)).filter(Boolean);
                $selected.innerHTML = cats
                    .map((c) => `<button type="button" class="chip" data-id="${c.id}" title="Quitar ${UI.esc(c.name)}">${UI.esc(c.name)}${UI.ICONS.x}</button>`)
                    .join("");
                $hidden.innerHTML = cats.map((c) => `<input type="hidden" name="CategoriaIds" value="${c.id}">`).join("");
            }
            function add(id) { selected.add(id); renderSelected(); $q.value = ""; openResults(); $q.focus(); }

            $q.addEventListener("focus", openResults);
            $q.addEventListener("input", openResults);
            $q.addEventListener("keydown", (e) => {
                const opts = [...$results.querySelectorAll("button.cat-option")];
                if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                    e.preventDefault();
                    if (!opts.length) return;
                    focusIdx = (focusIdx + (e.key === "ArrowDown" ? 1 : -1) + opts.length) % opts.length;
                    opts.forEach((o, i) => o.classList.toggle("focus", i === focusIdx));
                    opts[focusIdx].scrollIntoView({ block: "nearest" });
                } else if (e.key === "Enter") {
                    e.preventDefault();
                    const o = opts[focusIdx] || (opts.length === 1 ? opts[0] : null);
                    if (o) add(Number(o.dataset.id));
                } else if (e.key === "Escape") closeResults();
            });
            $results.addEventListener("mousedown", (e) => e.preventDefault());
            $results.addEventListener("click", (e) => {
                const o = e.target.closest("button.cat-option");
                if (o) add(Number(o.dataset.id));
            });
            $q.addEventListener("blur", closeResults);
            $selected.addEventListener("click", (e) => {
                const chip = e.target.closest(".chip");
                if (!chip) return;
                selected.delete(Number(chip.dataset.id));
                renderSelected();
            });
            renderSelected();

            $titulo.addEventListener("input", () => $titulo.classList.remove("invalid"));
            $form.addEventListener("submit", (e) => {
                if (!$titulo.value.trim()) {
                    e.preventDefault();
                    $titulo.classList.add("invalid");
                    $titulo.focus();
                }
            });
        });
    </script>
}
