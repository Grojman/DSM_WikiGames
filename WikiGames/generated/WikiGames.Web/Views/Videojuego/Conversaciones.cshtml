@* MANUAL FILE (not generated by HARIA). Migrada desde WikiGames.HTML/conversaciones.html. *@
@model WikiGames.Web.ViewModels.Paginas.ConversacionesJuegoViewModel
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = $"Conversaciones · {Model.Videojuego.Titulo}";
    ViewData["Page"] = "conversaciones";
}

<main class="container narrow">
    <partial name="WikiGames/_GameHeader" model="Model.Videojuego" view-data='new ViewDataDictionary(ViewData) { ["Tab"] = "conversaciones" }' />

    <h2 class="page-title">Conversaciones</h2>

    <section id="list" class="thread-list" aria-label="Temas de conversación">
        @if (Model.Temas.Count == 0)
        {
            <div class="empty">Aún no hay conversaciones sobre este juego.</div>
        }
        @foreach (var t in Model.Temas)
        {
            <a class="card thread-card" id="tema-@t.Id" href="../../TemaConversacion/Details/@t.Id">
                <h3 class="thread-title">@t.Titulo</h3>
                <p class="thread-desc">@t.Texto</p>
                <div class="thread-meta">
                    <partial name="WikiGames/_Avatar" model="t.UsuarioCreadorLabel" /><span>@(t.UsuarioCreadorLabel ?? "usuario eliminado")</span>
                    <span aria-hidden="true">·</span>
                    <time datetime="@t.FechaCreacion.ToString("o")">@t.FechaCreacion.ToString("dd MMM yyyy")</time>
                    <span aria-hidden="true">·</span>
                    <span>@t.NumeroRespuestas @(t.NumeroRespuestas == 1 ? "respuesta" : "respuestas")</span>
                </div>
            </a>
        }
    </section>
</main>
