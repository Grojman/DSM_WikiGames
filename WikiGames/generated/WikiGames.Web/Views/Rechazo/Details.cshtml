@model WikiGames.Web.ViewModels.RechazoViewModel
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Detalle del rechazo";
}

<main class="container narrow">
    <a class="back-link" asp-controller="Notificacion" asp-action="Lista"><span data-icon="back"></span>Volver a notificaciones</a>

    <h1 class="page-title">Lo sentimos, tu propuesta ha sido rechazada</h1>

    <article class="card form-card" aria-label="Detalle del rechazo">
        <div class="form-group">
            <span class="label">Motivo</span>
            <p class="review-text">@Model.Motivo</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.VideojuegoLabel))
        {
            <div class="form-group">
                <span class="label">Videojuego</span>
                @if (Model.VideojuegoId is int videojuegoId)
                {
                    <a class="chip" asp-controller="Videojuego" asp-action="Ficha" asp-route-id="@videojuegoId"><span data-icon="gamepad"></span><span>@Model.VideojuegoLabel</span></a>
                }
                else
                {
                    <span class="chip"><span data-icon="gamepad"></span><span>@Model.VideojuegoLabel</span></span>
                }
            </div>
        }

        <div class="form-group">
            <span class="label">Revisado por</span>
            <p class="review-text">@(Model.GestorLabel ?? "Moderación")</p>
            <p class="hint">El <time datetime="@Model.Fecha.ToString("o")">@Model.Fecha.ToString("dd 'de' MMMM 'de' yyyy")</time></p>
        </div>

        <div class="form-actions">
            <a class="btn" asp-controller="Notificacion" asp-action="Lista">Volver</a>
            @if (Model.VideojuegoId is int idJuego)
            {
                <a class="btn btn-primary" asp-controller="Videojuego" asp-action="Ficha" asp-route-id="@idJuego">Ver videojuego</a>
            }
        </div>
    </article>
</main>
