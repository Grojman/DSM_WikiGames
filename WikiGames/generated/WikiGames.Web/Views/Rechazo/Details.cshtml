@model WikiGames.Web.ViewModels.RechazoViewModel

@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Detalles";
}
<main class="container narrow">
<div class="row justify-content-center">
    <div class="class="container narrow"">
        <div class="card border-0 shadow-sm">
            <h1 class="page-title">Lo sentimos, tu propuesta ha sido rechazada</h1>
            <div class="card form-card">
                <dl class="row mb-0 gy-2">
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.Motivo)</dd>
            <br /><br /><dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.VideojuegoLabel)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.VideojuegoLabel)</dd>
            <br /><br /><dt class="col-sm-4 col-lg-3 text-body-secondary">@Html.DisplayNameFor(model => model.GestorLabel)</dt>
            <dd class="col-sm-8 col-lg-9">@Html.DisplayFor(model => model.GestorLabel)</dd>
            <br /><dd name="toast" style="text-alaign: right; float: left;">@Html.DisplayFor(model => model.Fecha)</dd>
                </dl>


            </div>
            <div class="card-footer bg-body p-4">
                <div class="d-flex flex-column flex-sm-row gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
                <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
            </div>
            </div>
        </div>
    </div>
</div>
</main>
<nav data-bottombar></nav>
<script src="js/common.js"></script>
<script src="js/data.js"></script>