@* MANUAL FILE (not generated by HARIA). Migrada desde WikiGames.HTML/denuncias.html. Moderadores y administradores. *@
@model WikiGames.Web.ViewModels.Paginas.ListaDenunciasViewModel
@using WikiGames.Domain.Enums
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Denuncias";
    ViewData["Page"] = "denuncias";
    var filtros = new (EstadoContenido? Estado, string Texto)[]
    {
        (null, "Todas"), (EstadoContenido.Pendiente, "Pendientes"), (EstadoContenido.Aprobado, "Aprobadas"), (EstadoContenido.Rechazado, "Rechazadas"),
    };
    var estados = new[] { EstadoContenido.Pendiente, EstadoContenido.Aprobado, EstadoContenido.Rechazado };
}

<main class="container">
    <div class="center"><span class="admin-badge">Administradores y moderadores</span></div>
    <h1 class="page-title">Denuncias</h1>

    <div class="center">
        <nav id="seg" class="seg" aria-label="Filtrar por estado">
            @foreach (var f in filtros)
            {
                <a class="@(Model.Estado == f.Estado ? "active" : "")" asp-controller="Denuncia" asp-action="Lista" asp-route-estado="@f.Estado"
                   aria-current="@(Model.Estado == f.Estado ? "page" : null)">@f.Texto</a>
            }
        </nav>
    </div>

    <section id="list" class="admin-list" aria-label="Lista de denuncias">
        @if (Model.Denuncias.Count == 0)
        {
            <div class="empty">No hay denuncias con este estado.</div>
        }
        @foreach (var d in Model.Denuncias)
        {
            var pendiente = d.Estado == EstadoContenido.Pendiente;
            <article class="card report-card" data-href="@d.EnlaceContenido" tabindex="0" aria-label="Denuncia #@d.Id: ver @d.TipoContenido.ToLowerInvariant() denunciado">
                <div class="report-main">
                    <partial name="WikiGames/_Avatar" model="d.DenuncianteLabel" />
                    <div>
                        <div class="line">@(d.DenuncianteLabel ?? "usuario eliminado") <span class="muted">ha denunciado</span>
                            @if (d.EnlaceContenido is null)
                            {
                                <span class="target"><span data-icon="flag"></span>@d.EtiquetaContenido</span>
                            }
                            else
                            {
                                <a class="target" href="@d.EnlaceContenido"><span data-icon="flag"></span>@d.EtiquetaContenido</a>
                            }
                        </div>
                        <div class="sub">@d.TipoContenido · Denuncia #@d.Id · @d.Fecha.ToString("dd MMM yyyy, HH:mm")</div>
                    </div>
                </div>
                @* El estado solo puede pasar de Pendiente a Aprobado / Rechazado (DenunciaUseCase). *@
                <form class="inline-form" method="post" asp-controller="Denuncia" asp-action="Resolver" asp-route-id="@d.Id" asp-route-filtro="@Model.Estado">
                    <select class="field status-@d.Estado" name="estado" data-autosubmit disabled="@(!pendiente)" aria-label="Estado de la denuncia #@d.Id">
                        @foreach (var e in estados)
                        {
                            <option value="@e" selected="@(e == d.Estado)">@e</option>
                        }
                    </select>
                </form>
                <div class="report-actions">
                    <form class="inline-form" method="post" asp-controller="Denuncia" asp-action="Resolver" asp-route-id="@d.Id" asp-route-filtro="@Model.Estado">
                        <input type="hidden" name="estado" value="@EstadoContenido.Aprobado">
                        <button class="btn btn-sm btn-success" type="submit" disabled="@(!pendiente)"><span data-icon="check"></span>Aceptar</button>
                    </form>
                    <form class="inline-form" method="post" asp-controller="Denuncia" asp-action="Resolver" asp-route-id="@d.Id" asp-route-filtro="@Model.Estado">
                        <input type="hidden" name="estado" value="@EstadoContenido.Rechazado">
                        <button class="btn btn-sm btn-danger" type="submit" disabled="@(!pendiente)"><span data-icon="x"></span>Rechazar</button>
                    </form>
                </div>
            </article>
        }
    </section>
</main>
