@model WikiGames.Web.ViewModels.LoginViewModel

@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Iniciar sesión";
}
   <main class="container narrow">
        <h1 class="page-title">Iniciar sesion</h1>
    <div class="card form-card">
        <form asp-action="Login" method="post">
            <input asp-for="Identifier" type="text" placeholder="Email" class="field">
            <br><br><input asp-for="Password" type="password" placeholder="Contraseña" class="field">
            <br><br><input type="submit" class="btn btn-primary" value="Acceder">
        </form>
    </div>
    <div>
        <p>¿No tienes cuenta?</p>
       <a href="/Usuario/Register"><button>Creala aquí</button></a>
    </div>
    </main>
    <script src="js/common.js"></script>
    <script src="js/data.js"></script>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
