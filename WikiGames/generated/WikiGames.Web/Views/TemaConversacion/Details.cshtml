@model WikiGames.Web.ViewModels.TemaConversacionViewModel
@using WikiGames.Web.Utils.Paginas
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = Model.Titulo;
    ViewData["Page"] = "conversaciones";
    var esAutor = WikiGamesPaginas.UsuarioActualId(User) is int uid && uid == Model.UsuarioCreadorId;
}

<main class="container narrow">
    @if (Model.VideojuegoId is int videojuegoId)
    {
        <a class="back-link" asp-controller="Videojuego" asp-action="Conversaciones" asp-route-id="@videojuegoId" asp-fragment="tema-@Model.Id"><span data-icon="back"></span>Volver a las conversaciones</a>
    }

    <article class="card form-card" aria-label="Tema de conversación">
        <h1 class="thread-title">@Model.Titulo</h1>
        <div class="thread-meta">
            <partial name="WikiGames/_Avatar" model="Model.UsuarioCreadorLabel" /><span>@(Model.UsuarioCreadorLabel ?? "usuario eliminado")</span>
            <span aria-hidden="true">·</span>
            <time datetime="@Model.FechaCreacion.ToString("o")">@Model.FechaCreacion.ToString("dd MMM yyyy")</time>
            @if (!string.IsNullOrEmpty(Model.VideojuegoLabel))
            {
                <span aria-hidden="true">·</span>
                <span class="videogame-font">@Model.VideojuegoLabel</span>
            }
        </div>
        <p class="review-text" style="margin-top: 16px;">@Model.Texto</p>

        <div class="form-actions">
            <span class="comment-likes"><span data-icon="heart"></span> @Model.NumeroMeGusta Me gusta</span>
            @if (esAutor)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm">Editar</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-ghost btn-danger"><span data-icon="trash"></span>Eliminar</a>
            }
        </div>
    </article>

    <h2 class="page-title" style="margin-top: 32px;">Comentarios (@Model.Comentarios.Count)</h2>

    @if (Model.Comentarios.Any())
    {
        <div class="comment-tree">
            @foreach (var comentario in Model.Comentarios)
            {
                <div class="card comment-item@(comentario.Nivel > 0 ? " comment-reply" : "")"
                     id="comentario-@comentario.Id"
                     style="margin-left: @(Math.Min(comentario.Nivel, 6) * 32)px">
                    <p class="review-text">@comentario.Texto</p>

                    <div class="thread-meta">
                        <partial name="WikiGames/_Avatar" model="comentario.UsuarioCreadorLabel" /><span>@(comentario.UsuarioCreadorLabel ?? "usuario eliminado")</span>
                        <span aria-hidden="true">·</span>
                        <time datetime="@comentario.FechaCreacion.ToString("o")">@comentario.FechaCreacion.ToString("dd MMM yyyy HH:mm")</time>
                    </div>

                    <div class="comment-actions">
                        @if (Model.EstaAutenticado)
                        {
                            <form class="inline-form" method="post" asp-action="AlternarMeGustaComentario" asp-route-id="@Model.Id" asp-route-comentarioId="@comentario.Id">
                                <button type="submit" class="btn btn-sm @(comentario.TieneMeGusta ? "btn-active" : "")"
                                        title="@(comentario.TieneMeGusta ? "Quitar me gusta" : "Dar me gusta")">
                                    <span data-icon="heart"></span>
                                    <span>@comentario.NumeroMeGusta Me gusta</span>
                                </button>
                            </form>

                            <details class="comment-reply-box">
                                <summary class="btn btn-sm">Responder</summary>
                                <form method="post" asp-action="ResponderComentario" asp-route-id="@Model.Id" asp-route-comentarioId="@comentario.Id" class="comment-reply-form">
                                    <textarea name="texto" class="field" rows="3" required maxlength="2000"
                                              placeholder="Escribe tu respuesta..." aria-label="Respuesta al comentario"></textarea>
                                    <button type="submit" class="btn btn-sm">Enviar respuesta</button>
                                </form>
                            </details>
                        }
                        else
                        {
                            <span class="comment-likes"><span data-icon="heart"></span> @comentario.NumeroMeGusta Me gusta</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty">Todavía no hay comentarios en este tema.</div>
    }
</main>
