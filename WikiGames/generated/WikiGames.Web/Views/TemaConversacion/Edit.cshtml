@model WikiGames.Web.ViewModels.TemaConversacionViewModel
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Editar conversación";
}

<main class="container narrow">
    <a class="back-link" asp-action="Details" asp-route-id="@Model.Id"><span data-icon="back"></span>Volver a la conversación</a>

    <h1 class="page-title">Editar conversación</h1>

    <div class="card form-card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>

            <input type="hidden" asp-for="Id" />
            @* Campos que el usuario no edita: se conservan tal cual. *@
            <input type="hidden" asp-for="FechaCreacion" value="@Model.FechaCreacion.ToString("yyyy-MM-ddTHH:mm:ss")" />
            <input type="hidden" asp-for="NumeroMeGusta" />
            <input type="hidden" asp-for="UsuarioCreadorId" />

            <div class="form-group">
                <label asp-for="Titulo" class="label">Título <span class="req" aria-hidden="true">*</span></label>
                <input asp-for="Titulo" class="field" placeholder="Título de la conversación" required />
                <span asp-validation-for="Titulo"></span>
            </div>

            <div class="form-group">
                <label asp-for="Texto" class="label">Mensaje <span class="req" aria-hidden="true">*</span></label>
                <textarea asp-for="Texto" class="field" placeholder="Contenido a mostrar" required></textarea>
                <span asp-validation-for="Texto"></span>
            </div>

            <div class="form-group">
                <label asp-for="VideojuegoId" class="label">Videojuego <span class="req" aria-hidden="true">*</span></label>
                <select asp-for="VideojuegoId" asp-items="Model.VideojuegoOptions" class="field">
                    <option value="">Selecciona un videojuego...</option>
                </select>
                <span asp-validation-for="VideojuegoId"></span>
            </div>

            <div class="form-actions">
                <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a>
                <button type="submit" class="btn btn-primary">Guardar cambios</button>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
