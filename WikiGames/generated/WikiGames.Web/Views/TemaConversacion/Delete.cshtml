@model WikiGames.Web.ViewModels.TemaConversacionViewModel
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Eliminar conversación";
}

<main class="container narrow">
    <a class="back-link" asp-action="Details" asp-route-id="@Model.Id"><span data-icon="back"></span>Volver a la conversación</a>

    <h1 class="page-title">Eliminar conversación</h1>

    <article class="card form-card">
        <p class="hint">Revisa la conversación antes de eliminarla. Esta acción no se puede deshacer.</p>

        <h2 class="thread-title">@Model.Titulo</h2>
        <div class="thread-meta">
            <partial name="WikiGames/_Avatar" model="Model.UsuarioCreadorLabel" /><span>@(Model.UsuarioCreadorLabel ?? "usuario eliminado")</span>
            <span aria-hidden="true">·</span>
            <time datetime="@Model.FechaCreacion.ToString("o")">@Model.FechaCreacion.ToString("dd MMM yyyy")</time>
            @if (!string.IsNullOrEmpty(Model.VideojuegoLabel))
            {
                <span aria-hidden="true">·</span>
                <span class="videogame-font">@Model.VideojuegoLabel</span>
            }
        </div>
        <p class="review-text" style="margin-top: 16px;">@Model.Texto</p>

        <form asp-action="Delete" method="post" class="form-actions">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <a class="btn btn-ghost" asp-action="Details" asp-route-id="@Model.Id">Cancelar</a>
            <button type="submit" class="btn btn-danger"><span data-icon="trash"></span>Eliminar definitivamente</button>
        </form>
    </article>
</main>
