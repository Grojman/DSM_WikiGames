@model IEnumerable<WikiGames.Web.ViewModels.TemaConversacionViewModel>
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Conversaciones";
    ViewData["Page"] = "conversaciones";
}

<main class="container narrow">
    <h1 class="page-title">Conversaciones</h1>

    <div class="form-actions" style="justify-content: center; margin-bottom: 24px;">
        <a asp-action="Create" class="btn btn-primary"><span data-icon="plus"></span>Crear conversación</a>
    </div>

    <section class="thread-list" aria-label="Temas de conversación">
        @if (!Model.Any())
        {
            <div class="empty">Todavía no hay conversaciones.</div>
        }
        @foreach (var t in Model.OrderByDescending(t => t.FechaCreacion))
        {
            <a class="card thread-card" id="tema-@t.Id" asp-action="Details" asp-route-id="@t.Id">
                <h3 class="thread-title">@t.Titulo</h3>
                <p class="thread-desc">@t.Texto</p>
                <div class="thread-meta">
                    <partial name="WikiGames/_Avatar" model="t.UsuarioCreadorLabel" /><span>@(t.UsuarioCreadorLabel ?? "usuario eliminado")</span>
                    <span aria-hidden="true">·</span>
                    <time datetime="@t.FechaCreacion.ToString("o")">@t.FechaCreacion.ToString("dd MMM yyyy")</time>
                    @if (!string.IsNullOrEmpty(t.VideojuegoLabel))
                    {
                        <span aria-hidden="true">·</span>
                        <span class="videogame-font">@t.VideojuegoLabel</span>
                    }
                    <span aria-hidden="true">·</span>
                    <span><span data-icon="heart"></span> @t.NumeroMeGusta</span>
                </div>
            </a>
        }
    </section>
</main>
