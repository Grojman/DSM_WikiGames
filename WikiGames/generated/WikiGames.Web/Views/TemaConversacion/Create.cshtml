```cshtml
@model WikiGames.Web.ViewModels.TemaConversacionViewModel
@using WikiGames.Web.Models.Usuarios

@{
    var usuario = User.AsUsuarioModel();
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Crear";
}

<main class="container narrow">
    <h1 class="page-title">Crear conversación</h1>

    <div class="card form-card">
        <form asp-controller="TemaConversacion" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <label asp-for="Titulo" class="label">
                Título <span class="req" aria-hidden="true">*</span>
            </label>
            <input asp-for="Titulo"
                   id="titulo"
                   type="text"
                   placeholder="Título de la conversación"
                   class="field"
                   required />
            <span asp-validation-for="Titulo" class="text-danger"></span>

            <br /><br />

            <label asp-for="Texto" class="label">
                Mensaje <span class="req" aria-hidden="true">*</span>
            </label>
            <textarea asp-for="Texto"
                      id="texto"
                      placeholder="Contenido a mostrar"
                      class="field"
                      required></textarea>
            <span asp-validation-for="Texto" class="text-danger"></span>

            <br /><br />

            <label asp-for="VideojuegoId" class="label"></label>
            <select asp-for="VideojuegoId"
                    asp-items="Model.VideojuegoOptions"
                    class="field">
                <option value="">Selecciona un videojuego...</option>
            </select>
            <span asp-validation-for="VideojuegoId" class="text-danger"></span>

            <input asp-for="NumeroMeGusta" type="hidden" value="0" />

            <input asp-for="UsuarioCreadorId"
                   type="hidden"
                   value="@usuario?.Id" />

            <div class="form-actions">
                <a class="btn btn-ghost"
                   asp-controller="Home"
                   asp-action="Index">
                    Cancelar
                </a>

                <button type="submit" class="btn btn-primary">
                    Crear
                </button>
            </div>
        </form>
    </div>
</main>

<nav data-bottombar></nav>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
```