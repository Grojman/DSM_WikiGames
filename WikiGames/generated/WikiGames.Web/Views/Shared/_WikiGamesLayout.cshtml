@* MANUAL FILE (not generated by HARIA). Layout de las páginas WikiGames (migradas desde WikiGames.HTML). *@
@* Las páginas CRUD generadas siguen usando _Layout.cshtml (Bootstrap). *@
@using WikiGames.Web.Models.Usuarios
@{
    var pagina = ViewData["Page"] as string ?? string.Empty;
    var usuario = User.AsUsuarioModel();
    var autenticado = User.Identity?.IsAuthenticated == true;

    // En las páginas de inicio de sesión y registro no se muestran las barras de navegación.
    var controlador = ViewContext.RouteData.Values["controller"] as string;
    var accion = ViewContext.RouteData.Values["action"] as string;
    var esPaginaAuth = ((string.Equals(controlador, "Account", StringComparison.OrdinalIgnoreCase) || string.Equals(controlador, "Login", StringComparison.OrdinalIgnoreCase))
                        && string.Equals(accion, "Login", StringComparison.OrdinalIgnoreCase))
                    || (string.Equals(controlador, "Usuario", StringComparison.OrdinalIgnoreCase) && string.Equals(accion, "Register", StringComparison.OrdinalIgnoreCase));
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>WikiGames · @ViewData["Title"]</title>
    <link rel="icon" href="~/favicon.ico">
    <link rel="stylesheet" href="~/css/wikigames.css" asp-append-version="true">
</head>
<body data-page="@pagina" data-toast="@TempData["Toast"]">
    @if (!esPaginaAuth)
    {
    <header class="navbar">
        <a class="brand" asp-controller="Home" asp-action="Index"><span data-icon="logo"></span><span>WikiGames</span></a>
        <nav class="nav-actions" aria-label="Cuenta">
            @if (usuario is ModeradorModel)
            {
                <a class="icon-btn" asp-controller="Videojuego" asp-action="Pendientes" title="Videojuegos pendientes" aria-label="Videojuegos pendientes"><span data-icon="gamepad"></span></a>
                <a class="icon-btn" asp-controller="Denuncia" asp-action="Lista" title="Denuncias" aria-label="Denuncias"><span data-icon="flag"></span></a>
            }
            @if (usuario is AdministradorModel)
            {
                <a class="icon-btn" asp-controller="Usuario" asp-action="Lista" title="Usuarios" aria-label="Usuarios"><span data-icon="users"></span></a>
            }
            @if (autenticado)
            {
                <a class="icon-btn" asp-controller="Notificacion" asp-action="Lista" title="Notificaciones" aria-label="Notificaciones"><span data-icon="bell"></span></a>
            }
            <a class="icon-btn" href="#" title="Ajustes" aria-label="Ajustes"><span data-icon="settings"></span></a>
            @if (autenticado)
            {
                <span class="nav-user" title="@usuario?.Name">@(usuario?.Name ?? User.Identity!.Name)</span>
                <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                    <button class="btn btn-ghost" type="submit"><span data-icon="logout"></span><span>Cerrar sesión</span></button>
                </form>
            }
            else
            {
                <a class="btn btn-ghost" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"><span data-icon="login"></span><span>Iniciar sesión</span></a>
            }
        </nav>
    </header>
    }

    @RenderBody()

    @if (!esPaginaAuth)
    {
    <nav class="bottombar" aria-label="Accesos rápidos">
        <a href="#" class="bb-item @(pagina == "perfil" ? "active" : "")" title="Mi perfil"><span data-icon="user"></span><span>Perfil</span></a>
        <a asp-controller="Videojuego" asp-action="Nuevo" class="bb-item bb-primary @(pagina == "crear" ? "active" : "")" title="Publicar videojuego"><span data-icon="plus"></span><span>Publicar Videojuego</span></a>
        <a asp-controller="TemaConversacion" asp-action="Create" class="bb-item bb-primary @(pagina == "crear" ? "active" : "")" title="crear conversacion"><span data-icon="plus"></span><span>Crear conversacion</span></a>
        <a asp-controller="Contenido" asp-action="MeGusta" class="bb-item @(pagina == "favoritos" ? "active" : "")" title="Me gusta"><span data-icon="heart"></span><span>Me gusta</span></a>
    </nav>
    }

    <script src="~/js/wikigames.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
