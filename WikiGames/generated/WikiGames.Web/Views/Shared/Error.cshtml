@model ErrorViewModel
@{
    Layout = "_WikiGamesLayout";
    ViewData["Title"] = "Error";
}

<main class="container narrow">
    <h1 class="page-title">Se ha producido un error</h1>
    <div class="card form-card center">
        <span class="avatar lg" style="margin: 0 auto 16px;"><span data-icon="flag"></span></span>
        <p>No se ha podido completar la petición. Inténtalo de nuevo.</p>
        @if (Model.ShowRequestId)
        {
            <p class="hint">Identificador de petición: <code>@Model.RequestId</code></p>
        }
        <div class="form-actions" style="justify-content: center;">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>
        </div>
    </div>
</main>
