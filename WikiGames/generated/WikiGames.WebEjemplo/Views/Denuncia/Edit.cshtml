@* HARIA-WEB GENERATED sha256:22ace773b1b4d8095027144c8d42792d3feecc7ccfed8909fcb8129ca88c69f5 *@
@model WikiGames.WebEjemplo.ViewModels.DenunciaViewModel

@{
    ViewData["Title"] = "Editar";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-body p-4">
                <span class="badge text-bg-primary-subtle text-primary-emphasis mb-3">Editar</span>
                <h1 class="h3 mb-1">Denuncia</h1>
                <p class="text-body-secondary mb-0">Completa los campos y guarda los cambios.</p>
            </div>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body p-4">
                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
                    <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Fecha" class="form-label"></label>
            <input asp-for="Fecha" type="date" class="form-control" />
            <span asp-validation-for="Fecha" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Estado" class="form-label"></label>
            <select asp-for="Estado" asp-items="Html.GetEnumSelectList<WikiGames.Domain.Enums.EstadoContenido>()" class="form-select"></select>
            <span asp-validation-for="Estado" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="NotificacionId" class="form-label"></label>
            <select asp-for="NotificacionId" asp-items="Model.NotificacionOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="NotificacionId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DenuncianteId" class="form-label"></label>
            <select asp-for="DenuncianteId" asp-items="Model.DenuncianteOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="DenuncianteId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="DenunciadoId" class="form-label"></label>
            <select asp-for="DenunciadoId" asp-items="Model.DenunciadoOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="DenunciadoId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ContenidoDenunciadoId" class="form-label"></label>
            <select asp-for="ContenidoDenunciadoId" asp-items="Model.ContenidoDenunciadoOptions" class="form-select"><option value="">Selecciona...</option></select>
            <span asp-validation-for="ContenidoDenunciadoId" class="text-danger"></span>
        </div>
                </div>
                <div class="card-footer bg-body p-4 d-flex flex-column flex-sm-row gap-2">
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />


}
