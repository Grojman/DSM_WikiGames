<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="WikiGames.Domain"
                   namespace="WikiGames.Domain.Entities">
  <class name="AccionSistema" table="AccionSistema">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Fecha" type="Date">
      <column name="fecha" sql-type="date" not-null="true"/>
    </property>
    <property name="Descripcion" type="String">
      <column name="descripcion" not-null="true"/>
    </property>
    <many-to-one name="Causante" class="Usuario">
      <column name="FK_Usuario_causante" not-null="true"/>
    </many-to-one>
    <many-to-one name="ContenidoAfectado" class="Contenido">
      <column name="FK_Contenido_contenidoAfectado" not-null="true"/>
    </many-to-one>
  </class>
  <query name="AccionSistemaReadAllHQL">from AccionSistema</query>
</hibernate-mapping>
