<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="WikiGames.Domain"
                   namespace="WikiGames.Domain.Entities">
  <class name="Categoria" table="Categoria">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Name" type="String">
      <column name="name" unique="true" not-null="true"/>
    </property>
    <bag name="Hijos" inverse="true">
      <key>
        <column name="FK_Categoria_padre"/>
      </key>
      <one-to-many class="Categoria"/>
    </bag>
    <many-to-one name="Padre" class="Categoria">
      <column name="FK_Categoria_padre"/>
    </many-to-one>
    <many-to-one name="Videojuego" class="Videojuego">
      <column name="FK_Videojuego_videojuego" not-null="true"/>
    </many-to-one>
  </class>
  <query name="CategoriaReadAllHQL">from Categoria</query>
</hibernate-mapping>
