<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="WikiGames.Domain"
                   namespace="WikiGames.Domain.Entities">
  <class name="Usuario" table="Usuario">
    <id name="Id" column="id" type="Int32">
      <generator class="hilo"/>
    </id>
    <property name="Name" type="String">
      <column name="name" not-null="true"/>
    </property>
    <property name="Password" type="String">
      <column name="password" not-null="true"/>
    </property>
    <property name="RolUsuario" type="WikiGames.Domain.Enums.Rol, WikiGames.Domain">
      <column name="rolUsuario" not-null="true"/>
    </property>
    <bag name="ContenidoGenerado" inverse="true">
      <key>
        <column name="FK_Usuario_usuarioCreador"/>
      </key>
      <one-to-many class="Contenido"/>
    </bag>
    <bag name="Rechazos" inverse="true">
      <key>
        <column name="FK_Usuario_gestor"/>
      </key>
      <one-to-many class="Rechazo"/>
    </bag>
    <bag name="Acciones" inverse="true">
      <key>
        <column name="FK_Usuario_causante"/>
      </key>
      <one-to-many class="AccionSistema"/>
    </bag>
    <bag name="Notificaciones">
      <key>
        <column name="FK_Usuario_notificaciones"/>
      </key>
      <one-to-many class="Notificacion"/>
    </bag>
    <bag name="DenunciasGeneradas" inverse="true">
      <key>
        <column name="FK_Usuario_denunciante"/>
      </key>
      <one-to-many class="Denuncia"/>
    </bag>
    <bag name="DenunciasRecibidas" inverse="true">
      <key>
        <column name="FK_Usuario_denunciado"/>
      </key>
      <one-to-many class="Denuncia"/>
    </bag>
    <bag name="ContenidoFavorito">
      <key>
        <column name="FK_Usuario_contenidoFavorito"/>
      </key>
      <one-to-many class="Contenido"/>
    </bag>
  </class>
  <query name="UsuarioReadAllHQL">from Usuario</query>
</hibernate-mapping>
